# Python virtual environment — huge, machine-specific, never commit
venv/

# Python cache files
__pycache__/
*.pyc

# Jupyter checkpoint files
.ipynb_checkpoints/

# macOS system file
.DS_Store

# Batch-scoring output (api/main.py serves from this) - generated by
# scripts/export_recommendations.py, not hand-edited, safe to regenerate
data/recommendations_export.json

# LaTeX build artefacts
report/*.aux
report/*.log
report/*.out
report/*.synctex.gz

# fetch_overviews.py by-products — all regenerable or redundant.
# overview_plot_full.csv is what the fetcher writes before --install copies
# it over overview_plot.csv; the two end up byte-identical.
data/overview_plot_full.csv
data/.overview_fetch_checkpoint.csv
*.bak
